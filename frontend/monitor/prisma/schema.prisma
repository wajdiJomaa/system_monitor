generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Server {
  id        Int      @id @default(autoincrement())
  name      String   @default("Unnamed server")
  host      String
  port      Int
  createdAt DateTime @default(now())

  @@unique([host, port])
}
